<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keeps the GitHub Monitor dashboard alive.

  The dashboard is the queue source for anything that scales CI against it:
  when it is down, callers see failed polls and hold their current state
  instead of scaling, so a dashboard that quietly died overnight stops new CI
  from getting runners until someone notices. Nothing used to supervise it --
  start.sh runs the server in the foreground and it dies with its terminal.
  KeepAlive is the fix: launchd restarts it after a crash, a clean exit, or a
  bare `kill`, and RunAtLoad brings it up with the login session.

  This runs node directly instead of ./start.sh: macOS privacy protection
  silently denies a launchd-spawned /bin/bash any read under ~/Documents
  ("Operation not permitted" on start.sh, no prompt). node is allowed that
  access, so node is the program here and --env-file-if-exists replaces
  start.sh's .env sourcing. start.sh stays the entry point for manual runs
  with all its preflight checks; under launchd a busy port or bad .env just
  makes the server exit and launchd retries in 60s. Needs node >= 22.9 for
  the env-file flag.

  Install, control and watch it with start.sh, which rewrites the paths
  below for the checkout, node and $HOME it runs from:
    ./start.sh start | stop | restart | status | monitor | logs
  Stop deliberately (a bare `kill` only triggers a restart):
    ./start.sh stop

  Logs:
    ~/Library/Logs/github-monitor.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ryabinski.github-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>--env-file-if-exists=/Users/cigan/Documents/projects/github-monitor/.env</string>
        <string>server.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/cigan/Documents/projects/github-monitor</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- A crash loop must not hot-loop against GitHub's API. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/cigan/Library/Logs/github-monitor.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cigan/Library/Logs/github-monitor.log</string>

    <!-- launchd starts with a minimal PATH; keep the usual bins on it for
         anything the server shells out to. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
